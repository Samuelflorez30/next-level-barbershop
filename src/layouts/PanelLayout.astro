---
// Layout del panel de administración (barberos y admin).
import "../styles/global.css";
import type { PanelContext } from "../lib/panel-page";
import { btnSecondary, focusRing, select } from "../components/panel/ui";

interface Props {
  title: string;
  ctx: PanelContext;
  active: "panel" | "horario" | "dias-libres";
}
const { title, ctx, active } = Astro.props;
const { user, barbers, selected, href } = ctx;

const nav = [
  { key: "panel", label: "Panel", path: "/panel" },
  { key: "horario", label: "Horario", path: "/panel/horario" },
  { key: "dias-libres", label: "Días libres", path: "/panel/dias-libres" },
] as const;

const linkBase = `px-3 py-2 rounded-md text-xs font-bold tracking-widest uppercase transition-colors ${focusRing}`;
---

<!doctype html>
<html lang="es" class="bg-zinc-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/jpg" href="/favicon.jpg" />
    <title>{title} · Panel · Next Level Barbershop</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-white antialiased">
    <header class="border-b border-white/10 bg-zinc-950/95 sticky top-0 z-30 backdrop-blur">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-16 py-2 md:py-0 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href="/panel" class="flex items-center gap-3 shrink-0">
          <img src="/logo.jpg" alt="" class="w-9 h-9 rounded-full object-cover border border-[#D4AF37]/40" />
          <span class="hidden sm:inline font-serif font-bold tracking-widest text-[#D4AF37] uppercase text-sm">Next Level</span>
        </a>

        <nav class="order-3 md:order-none w-full md:w-auto flex items-center gap-1 -mx-1 overflow-x-auto" aria-label="Secciones del panel">
          {nav.map((item) => (
            <a
              href={href(item.path)}
              class={`${linkBase} whitespace-nowrap ${active === item.key ? "bg-[#D4AF37] text-black" : "text-zinc-400 hover:text-white hover:bg-white/5"}`}
              aria-current={active === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-3 min-w-0">
          {user.role === "admin" && (
            <label class="flex items-center gap-2 text-xs">
              <span class="hidden md:inline text-zinc-500 uppercase tracking-widest">Barbero</span>
              <select
                id="barber-select"
                class={`${select} py-1.5`}
                aria-label="Barbero seleccionado"
              >
                {barbers.map((b) => (
                  <option value={b.id} selected={b.id === selected.id}>{b.name}{b.isActive ? "" : " (inactivo)"}</option>
                ))}
              </select>
            </label>
          )}
          <span class="hidden lg:flex flex-col items-end leading-tight">
            <span class="text-xs text-zinc-300">{user.username}</span>
            <span class="text-[10px] uppercase tracking-widest text-[#D4AF37]">{user.role === "admin" ? "Administrador" : selected.name}</span>
          </span>
          <form method="post" action="/api/auth/logout">
            <button type="submit" class={`${btnSecondary} px-3 py-2 rounded-md`}>
              Salir
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      // Selector de barbero (admin): cambia ?barberId= conservando la ruta.
      const select = document.getElementById("barber-select") as HTMLSelectElement | null;
      select?.addEventListener("change", () => {
        const url = new URL(location.href);
        url.searchParams.set("barberId", select.value);
        location.href = url.toString();
      });
    </script>
  </body>
</html>
