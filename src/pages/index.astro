---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Next Level Barbershop | Inicio">
	<!-- min-h-screen asegura que el contenedor ocupe el 100% del viewport (área visible del navegador) -->
	<main
		class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden"
	>
		<!-- Contenedor centralizado para el branding -->
		<div class="z-10 flex flex-col items-center text-center">
			<h1
				class="text-5xl md:text-7xl font-serif text-[#D4AF37] tracking-widest mb-2 drop-shadow-lg"
			>
				NEXT LEVEL
			</h1>
			<p
				class="text-sm md:text-base tracking-[0.4em] uppercase text-zinc-400"
			>
				Barber Shop
			</p>

			<div class="mt-12">
				<a
					href="#reservas"
					class="px-8 py-3 border border-[#D4AF37] text-[#D4AF37] hover:bg-[#D4AF37] hover:text-black transition-colors duration-300 tracking-widest text-sm"
				>
					RESERVAR AHORA
				</a>
			</div>
		</div>
	</main>
</Layout>
