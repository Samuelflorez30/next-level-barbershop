---
// src/components/Testimonials.astro
// Definición del modelo de datos estático simulando el payload (carga útil de datos) de una API
const reviews = [
    {
        author: "Carlos Mendoza",
        rating: 5,
        text: "La mejor experiencia de barbería en Neiva. La atención al detalle en el perfilado de la barba es de otro nivel. Totalmente recomendado.",
        date: "Hace 2 semanas",
    },
    {
        author: "Andrés Felipe",
        rating: 5,
        text: "Instalaciones de primer nivel y un servicio impecable. El cuidado facial premium superó mis expectativas.",
        date: "Hace 1 mes",
    },
    {
        author: "Daniel Ramírez",
        rating: 5,
        text: "Profesionalismo puro. Se nota la calidad de los productos y la experiencia de los barberos. Mi nuevo lugar de confianza.",
        date: "Hace 2 meses",
    },
];

// SVG de una estrella dorada sólida para optimizar peticiones de red
const starIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-[#D4AF37]"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" /></svg>`;
---

<section id="reseñas" class="py-24 bg-[#0a0a0a] text-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6"
        >
            <div>
                <h2
                    class="text-3xl md:text-5xl font-serif text-[#D4AF37] tracking-widest mb-4"
                >
                    RESEÑAS
                </h2>
                <p class="text-zinc-400 uppercase tracking-widest text-sm">
                    Lo que dicen nuestros clientes en Google
                </p>
            </div>

            <a
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-2 border border-zinc-700 hover:border-[#D4AF37] text-zinc-300 hover:text-[#D4AF37] transition-colors duration-300 text-sm tracking-wide"
            >
                CALIFICAR EN GOOGLE
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                reviews.map((review) => (
                    <div class="p-8 bg-zinc-900 border border-zinc-800">
                        <div
                            class="flex gap-1 mb-4"
                            set:html={starIcon.repeat(review.rating)}
                        />
                        <p class="text-zinc-300 mb-6 italic leading-relaxed text-sm">
                            "{review.text}"
                        </p>
                        <div class="flex justify-between items-center border-t border-zinc-800 pt-4">
                            <span class="font-semibold text-white tracking-wide text-sm">
                                {review.author}
                            </span>
                            <span class="text-zinc-500 text-xs">
                                {review.date}
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
