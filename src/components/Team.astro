---
const team = [
	{
		name: "Alexander",
		role: "Master Barber & Fundador",
		quote: "La perfección no es un objetivo, es nuestro estándar.",
		image: "https://images.unsplash.com/photo-1618306899757-084a96b49089?auto=format&fit=crop&w=800&q=80",
		instagram: "@alexander.cuts"
	},
	{
		name: "Christian",
		role: "Especialista Freestyle",
		quote: "Tu cabello es el lienzo, la navaja es mi pincel.",
		image: "https://images.unsplash.com/photo-1595152772835-219674b2a8a6?auto=format&fit=crop&w=800&q=80",
		instagram: "@chris.freestyle"
	},
	{
		name: "Sebastián",
		role: "Colorista & Asesor de Imagen",
		quote: "Diseñamos un estilo que hable por ti antes de que digas una palabra.",
		image: "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=800&q=80",
		instagram: "@sebas.color"
	}
];
---

<section id="equipo" class="py-24 bg-zinc-950 relative overflow-hidden">
	{/* Elemento decorativo de fondo */}
	<div class="absolute top-0 right-0 w-96 h-96 bg-[#D4AF37]/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="text-center mb-16">
			<h2
				class="text-3xl md:text-5xl font-serif font-bold tracking-widest text-[#D4AF37] uppercase mb-4"
			>
				Los Maestros
			</h2>
			<p class="text-zinc-400 max-w-2xl mx-auto text-base md:text-lg">
				Conoce a los artistas detrás de nuestra excelencia. 
				No solo cortamos cabello, esculpimos identidades.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
			{
				team.map((barber) => (
					<div class="group relative overflow-hidden rounded-2xl cursor-pointer aspect-[3/4] shadow-2xl">
						{/* Imagen Base (Escala de Grises por defecto) */}
						<img
							src={barber.image}
							alt={`Retrato de ${barber.name}`}
							class="absolute inset-0 w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-in-out"
							loading="lazy"
						/>
						
						{/* Degradado Superpuesto para Texto */}
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90 group-hover:opacity-70 transition-opacity duration-500"></div>

						{/* Marco Interior Dorado (Aparece en hover) */}
						<div class="absolute inset-4 border border-[#D4AF37]/0 group-hover:border-[#D4AF37]/30 transition-colors duration-700 pointer-events-none rounded-xl"></div>

						{/* Información del Barbero */}
						<div class="absolute inset-0 flex flex-col justify-end p-8 translate-y-10 group-hover:translate-y-0 transition-transform duration-500 ease-out">
							
							<h3 class="text-3xl font-serif font-bold text-white mb-1 group-hover:text-[#D4AF37] transition-colors">
								{barber.name}
							</h3>
							<p class="text-[#D4AF37] text-sm font-black tracking-widest uppercase mb-4">
								{barber.role}
							</p>
							
							{/* Línea Separadora animada */}
							<div class="h-px w-0 bg-[#D4AF37]/50 group-hover:w-full transition-all duration-700 delay-100 mb-4"></div>
							
							{/* Texto Revelado */}
							<div class="opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-200">
								<p class="text-zinc-300 text-sm italic leading-relaxed mb-4">
									"{barber.quote}"
								</p>
								
								{/* Botón Instagram Fake */}
								<div class="inline-flex items-center space-x-2 text-white/50 hover:text-white transition-colors">
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
									</svg>
									<span class="text-xs font-semibold tracking-wider">{barber.instagram}</span>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
