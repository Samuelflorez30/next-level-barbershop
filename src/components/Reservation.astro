---
// src/components/Reservation.astro
---

<section id="reservar" class="py-24 bg-[#0a0a0a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 rounded-2xl overflow-hidden shadow-2xl shadow-black/50 border border-white/10">
      
      <!-- Columna Gráfica (Izquierda) -->
      <div 
        class="relative min-h-[300px] md:min-h-full bg-cover bg-center bg-no-repeat bg-[#0a0a0a]"
        style="background-image: url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=1470&q=80');"
        aria-hidden="true"
      >
        <!-- Filtro de superposición para mantener la elegancia y contraste -->
        <div class="absolute inset-0 bg-black/60 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#0a0a0a]/90 to-transparent"></div>
      </div>

      <!-- Columna de Conversión (Derecha) -->
      <div class="flex flex-col justify-center p-10 md:p-16 lg:p-24 bg-zinc-950/80 backdrop-blur-sm">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold tracking-widest text-[#D4AF37] uppercase mb-6">
          Reserva tu espacio
        </h2>
        
        <p class="text-base md:text-lg text-zinc-300 leading-relaxed mb-10">
          Experimenta el verdadero lujo del cuidado masculino. Nuestra atención personalizada garantiza que cada corte y arreglo de barba sea ejecutado con precisión milimétrica y productos de la más alta gama. Asegura tu lugar de manera inmediata y sin complicaciones.
        </p>
        
        <div class="flex flex-col sm:flex-row items-start">
          <a 
            href="https://wa.me/573000000000?text=Hola%2C%20deseo%20agendar%20una%20cita%20en%20Next%20Level"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full sm:w-auto text-center px-10 py-4 text-sm font-bold tracking-widest text-black uppercase transition-all duration-300 rounded-lg bg-[#D4AF37] hover:bg-[#F3C53F] hover:scale-105 hover:shadow-[0_0_20px_rgba(212,175,55,0.4)] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#0a0a0a]"
            role="button"
          >
            Agendar Cita
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
