---
// src/components/Reservation.astro
import BookingWidget from "./booking/BookingWidget";
---

<section
  id="reservar"
  class="relative w-full bg-[url('/Interno.jpg')] bg-cover bg-center scroll-mt-16"
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/85 to-black/70"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Columna principal: widget de reserva -->
      <div class="lg:col-span-7 flex flex-col">
        <h2
          class="text-3xl md:text-5xl font-serif font-bold text-[#D4AF37] tracking-widest uppercase mb-3"
        >
          RESERVA TU ESPACIO
        </h2>
        <p class="text-zinc-400 text-base md:text-lg mb-8 max-w-xl">
          Elige tu servicio, tu barbero y la hora que mejor te quede. Tu cita
          queda confirmada al instante.
        </p>

        <BookingWidget client:load />
      </div>

      <!-- Columna secundaria: horario, dirección y mapa -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Bloque de Horarios -->
        <div class="flex items-start gap-3 text-zinc-300">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6 text-[#D4AF37] shrink-0"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
          </svg>
          <div class="flex flex-col">
            <span
              class="font-bold text-white uppercase text-sm tracking-widest mb-1"
              >Horario de Atención</span
            >
            <p class="text-zinc-400 text-sm tracking-wide">
              Lunes a Sábado: 9:00 AM - 9:00 PM<br />
              Domingos y Festivos: 10:00 AM - 9:00 PM
            </p>
          </div>
        </div>

        <!-- Bloque de Dirección Exacta -->
        <div
          class="flex items-center gap-3 text-zinc-400 text-sm tracking-wide"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 text-[#D4AF37] shrink-0"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path>
          </svg>
          <address class="not-italic">
            Calle 8 # 48-117, Segundo piso Local N2-12 en el centro comercial
            Santa Lucía Plaza Neiva, Huila.
          </address>
        </div>

        <!-- Mapa -->
        <div
          class="relative w-full flex-1 min-h-[400px] rounded-2xl overflow-hidden border border-white/10"
        >
          <iframe
            src="https://maps.google.com/maps?q=Santa%20Lucia%20Plaza,%20Neiva,%20Colombia+(Next%20Level%20Barbershop)&t=&z=16&ie=UTF8&iwloc=B&output=embed"
            class="absolute inset-0 w-full h-full border-0 grayscale-[20%] contrast-125"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Next Level Barbershop - Santa Lucía Plaza"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
