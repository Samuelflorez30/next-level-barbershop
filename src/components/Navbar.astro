---
// src/components/Navbar.astro
---

<header
  id="floating-nav"
  class="fixed top-5 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-4xl z-50 transition-all duration-500 rounded-[2rem] md:rounded-full bg-black/30 backdrop-blur-md border border-white/5 px-4 md:px-5 py-3"
>
  <nav
    class="flex items-center justify-between w-full"
    aria-label="Navegación Principal"
  >
    <!-- Logo a la izquierda -->
    <a href="#inicio" class="shrink-0" aria-label="Inicio">
      <img
        src="/logo.jpg"
        alt="Next Level Barbershop"
        class="w-9 h-9 rounded-full object-cover border border-[#D4AF37]/30"
      />
    </a>

    <!-- Enlaces centrados (Desktop) -->
    <ul
      class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2"
      role="menubar"
    >
      <li role="none">
        <a
          href="#inicio"
          class="text-[0.8rem] tracking-[0.12em] uppercase text-zinc-400 transition-colors duration-300 hover:text-white"
          role="menuitem"
        >
          Inicio
        </a>
      </li>
      <li role="none">
        <a
          href="#equipo"
          class="text-[0.8rem] tracking-[0.12em] uppercase text-zinc-400 transition-colors duration-300 hover:text-white"
          role="menuitem"
        >
          Profesionales
        </a>
      </li>
      <li role="none">
        <a
          href="#catalogo"
          class="text-[0.8rem] tracking-[0.12em] uppercase text-zinc-400 transition-colors duration-300 hover:text-white"
          role="menuitem"
        >
          Catálogo
        </a>
      </li>
    </ul>

    <!-- Botón Reservar (Desktop) + Hamburguesa (Móvil) -->
    <div class="flex items-center gap-3">
      <a
        href="#reservar"
        class="hidden md:inline-flex items-center justify-center px-5 py-2 text-[0.7rem] tracking-[0.15em] font-semibold uppercase text-black transition-all duration-300 rounded-full bg-[#D4AF37] hover:bg-[#e8c84a]"
        role="button"
      >
        Reservar
      </a>

      <!-- Hamburguesa (Móvil) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden relative w-9 h-9 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
      >
        <div class="w-4.5 flex flex-col gap-[5px] items-center justify-center">
          <span
            id="line-1"
            class="w-full h-[1.5px] bg-[#D4AF37] rounded-full transition-all duration-300 origin-center"
          ></span>
          <span
            id="line-2"
            class="w-full h-[1.5px] bg-[#D4AF37] rounded-full transition-all duration-300 origin-center"
          ></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Panel Móvil -->
  <div
    id="mobile-menu"
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out md:hidden"
  >
    <div class="overflow-hidden">
      <div class="flex flex-col items-center gap-5 pt-5 pb-3">
        <a
          href="#inicio"
          class="mobile-link text-base text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-3 duration-300"
          >Inicio</a
        >
        <a
          href="#equipo"
          class="mobile-link text-base text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-3 duration-300 delay-75"
          >Profesionales</a
        >
        <a
          href="#catalogo"
          class="mobile-link text-base text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-3 duration-300 delay-100"
          >Catálogo</a
        >
        <a
          href="#reservar"
          class="mobile-link w-full max-w-[180px] text-center px-5 py-2.5 text-sm font-semibold text-black rounded-full bg-[#D4AF37] transition-all opacity-0 translate-y-3 duration-300 delay-200"
          >Reservar</a
        >
      </div>
    </div>
  </div>
</header>

<script>
  const navElement = document.getElementById("floating-nav");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("line-1");
  const line2 = document.getElementById("line-2");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isMenuOpen = false;

  // Menú Móvil
  if (mobileBtn && mobileMenu) {
    const closeMenu = () => {
      if (!isMenuOpen) return;
      isMenuOpen = false;

      line1?.classList.remove("translate-y-[3.5px]", "rotate-45");
      line2?.classList.remove("-translate-y-[3.5px]", "-rotate-45");

      mobileLinks.forEach((link) => {
        link.classList.remove("opacity-100", "translate-y-0");
        link.classList.add("opacity-0", "translate-y-3");
      });

      setTimeout(() => {
        mobileMenu.classList.remove("grid-rows-[1fr]");
        mobileMenu.classList.add("grid-rows-[0fr]");
      }, 300);
    };

    mobileBtn.addEventListener("click", () => {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        line1?.classList.add("translate-y-[3.5px]", "rotate-45");
        line2?.classList.add("-translate-y-[3.5px]", "-rotate-45");

        mobileMenu.classList.remove("grid-rows-[0fr]");
        mobileMenu.classList.add("grid-rows-[1fr]");

        setTimeout(() => {
          mobileLinks.forEach((link) => {
            link.classList.remove("opacity-0", "translate-y-3");
            link.classList.add("opacity-100", "translate-y-0");
          });
        }, 100);
      } else {
        closeMenu();
      }
    });

    // Cerrar menu al hacer clic en un enlace
    mobileLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  // Efecto Scroll — solo cambia opacidad del fondo
  if (navElement) {
    window.addEventListener(
      "scroll",
      () => {
        if (isMenuOpen) return;

        if (window.scrollY > 50) {
          navElement.classList.remove("top-5", "bg-black/30");
          navElement.classList.add("top-2", "bg-black/60");
        } else {
          navElement.classList.add("top-5", "bg-black/30");
          navElement.classList.remove("top-2", "bg-black/60");
        }
      },
      { passive: true },
    );
  }
</script>
