---
// src/components/Navbar.astro
---

<header
  id="floating-nav"
  class="fixed top-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-5xl z-50 transition-all duration-500 rounded-[2rem] md:rounded-full border border-white/10 bg-black/40 backdrop-blur-xl px-4 md:px-6 py-4 shadow-2xl shadow-black/50"
>
  <nav
    class="flex items-center justify-between w-full relative z-10"
    aria-label="Navegación Principal"
  >
    <!-- Identidad de Marca -->
    <a
      href="/"
      class="text-xl md:text-2xl font-serif font-bold tracking-[0.2em] text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] to-[#F3C53F] uppercase focus:outline-none transition-transform hover:scale-105 duration-300"
      aria-label="Inicio Next Level"
    >
      NEXT LEVEL
    </a>

    <!-- Enlaces de Navegación (Desktop) -->
    <ul class="hidden md:flex items-center space-x-10" role="menubar">
      <li role="none">
        <a
          href="#inicio"
          class="relative text-sm font-medium text-zinc-300 transition-colors group hover:text-white focus:outline-none focus:text-white py-2"
          role="menuitem"
        >
          Inicio
          <span
            class="absolute bottom-0 left-0 w-full h-[1px] transition-transform duration-300 origin-center scale-x-0 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent group-hover:scale-x-100"
          ></span>
        </a>
      </li>
      <li role="none">
        <a
          href="#servicios"
          class="relative text-sm font-medium text-zinc-300 transition-colors group hover:text-white focus:outline-none focus:text-white py-2"
          role="menuitem"
        >
          Servicios
          <span
            class="absolute bottom-0 left-0 w-full h-[1px] transition-transform duration-300 origin-center scale-x-0 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent group-hover:scale-x-100"
          ></span>
        </a>
      </li>
      <li role="none">
        <a
          href="#resenas"
          class="relative text-sm font-medium text-zinc-300 transition-colors group hover:text-white focus:outline-none focus:text-white py-2"
          role="menuitem"
        >
          Reseñas
          <span
            class="absolute bottom-0 left-0 w-full h-[1px] transition-transform duration-300 origin-center scale-x-0 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent group-hover:scale-x-100"
          ></span>
        </a>
      </li>
    </ul>

    <!-- Botón de Acción y Toggle Móvil -->
    <div class="flex items-center gap-4">
      <a
        href="#reservar"
        class="hidden md:inline-flex items-center justify-center px-7 py-2 text-sm font-bold text-black transition-all duration-300 rounded-full bg-gradient-to-r from-[#D4AF37] to-[#F3C53F] hover:from-white hover:to-white hover:shadow-[0_0_20px_rgba(212,175,55,0.5)] focus:outline-none hover:-translate-y-0.5"
        role="button"
      >
        RESERVAR
      </a>

      <!-- Icono Menú Hamburguesa animado (Custom CSS) -->
      <button
        id="mobile-menu-btn"
        class="md:hidden relative w-10 h-10 text-white focus:outline-none rounded-full flex items-center justify-center bg-white/5 hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
      >
        <div class="w-5 flex flex-col gap-[6px] items-center justify-center">
          <span
            id="line-1"
            class="w-full h-[2px] bg-[#D4AF37] rounded-full transition-all duration-300 origin-center"
          ></span>
          <span
            id="line-2"
            class="w-full h-[2px] bg-[#D4AF37] rounded-full transition-all duration-300 origin-center"
          ></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Panel de Navegación Móvil (Animación usando CSS Grid fr) -->
  <div
    id="mobile-menu"
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out md:hidden"
  >
    <div class="overflow-hidden">
      <!-- Flex y gap están aquí adentro, donde sí aplican correctamente -->
      <div class="flex flex-col items-center gap-6 pt-6 pb-4">
        <a
          href="#inicio"
          class="mobile-link text-lg font-medium text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-4 duration-300"
          >Inicio</a
        >
        <a
          href="#servicios"
          class="mobile-link text-lg font-medium text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-4 duration-300 delay-75"
          >Servicios</a
        >
        <a
          href="#resenas"
          class="mobile-link text-lg font-medium text-zinc-300 hover:text-[#D4AF37] transition-all opacity-0 translate-y-4 duration-300 delay-150"
          >Reseñas</a
        >
        <a
          href="#reservar"
          class="mobile-link w-full max-w-[200px] text-center px-6 py-3 mt-2 text-sm font-bold text-black rounded-full bg-gradient-to-r from-[#D4AF37] to-[#F3C53F] shadow-[0_0_15px_rgba(212,175,55,0.3)] transition-all opacity-0 translate-y-4 duration-300 delay-200"
          >RESERVAR AHORA</a
        >
      </div>
    </div>
  </div>
</header>

<script>
  const navElement = document.getElementById("floating-nav");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("line-1");
  const line2 = document.getElementById("line-2");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isMenuOpen = false;

  // 1. Controlador del Menú Móvil
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener("click", () => {
      isMenuOpen = !isMenuOpen;

      if (isMenuOpen) {
        // Transformar icono en X
        // 4px es la mitad de la distancia total (gap 6px + height 2px)
        line1?.classList.add("translate-y-[4px]", "rotate-45");
        line2?.classList.add("-translate-y-[4px]", "-rotate-45");

        // Expandir contenedor (Magia de CSS Grid)
        mobileMenu.classList.remove("grid-rows-[0fr]");
        mobileMenu.classList.add("grid-rows-[1fr]");

        // Mostrar los enlaces con efecto cascada (stagger)
        setTimeout(() => {
          mobileLinks.forEach((link) => {
            link.classList.remove("opacity-0", "translate-y-4");
            link.classList.add("opacity-100", "translate-y-0");
          });
        }, 100);
      } else {
        // Transformar X en icono de hamburguesa
        line1?.classList.remove("translate-y-[4px]", "rotate-45");
        line2?.classList.remove("-translate-y-[4px]", "-rotate-45");

        // Ocultar los enlaces primero
        mobileLinks.forEach((link) => {
          link.classList.remove("opacity-100", "translate-y-0");
          link.classList.add("opacity-0", "translate-y-4");
        });

        // Contraer contenedor después de la animación de los enlaces
        setTimeout(() => {
          mobileMenu.classList.remove("grid-rows-[1fr]");
          mobileMenu.classList.add("grid-rows-[0fr]");
        }, 300);
      }
    });
  }

  // 2. Controlador del efecto Scroll
  if (navElement) {
    window.addEventListener(
      "scroll",
      () => {
        // Si el menú está abierto, no encogemos el Navbar
        if (isMenuOpen) return;

        if (window.scrollY > 50) {
          navElement.classList.remove("py-4", "top-6", "bg-black/40");
          navElement.classList.add(
            "py-2",
            "top-2",
            "bg-black/80",
            "backdrop-blur-2xl",
          );
        } else {
          navElement.classList.add("py-4", "top-6", "bg-black/40");
          navElement.classList.remove(
            "py-2",
            "top-2",
            "bg-black/80",
            "backdrop-blur-2xl",
          );
        }
      },
      { passive: true },
    );
  }
</script>
