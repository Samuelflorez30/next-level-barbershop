---

<section id="servicios" class="py-24 bg-zinc-950">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Header de la sección -->
		<div class="text-center mb-16">
			<h2
				class="text-3xl md:text-5xl font-serif font-bold tracking-widest text-[#D4AF37] uppercase mb-4"
			>
				Catálogo
			</h2>
			<p class="text-zinc-400 max-w-2xl mx-auto text-base md:text-lg">
				Explora nuestros servicios de élite, productos premium y
				descubre la experiencia inigualable que tenemos reservada para
				ti.
			</p>
		</div>

		<!-- Navegación de Pestañas (Tabs) -->
		<div
			class="flex justify-center border-b border-white/10 mb-12 overflow-x-auto hide-scrollbar"
		>
			<div class="flex space-x-6 md:space-x-12 min-w-max px-4">
				<button
					class="tab-btn pb-4 text-sm md:text-base font-bold tracking-widest uppercase transition-colors text-white border-b-2 border-[#D4AF37]"
					data-target="tab-servicios"
				>
					Servicios
				</button>
				<button
					class="tab-btn pb-4 text-sm md:text-base font-bold tracking-widest uppercase transition-colors text-zinc-500 border-b-2 border-transparent hover:text-zinc-300"
					data-target="tab-productos"
				>
					Productos
				</button>
				<button
					class="tab-btn pb-4 text-sm md:text-base font-bold tracking-widest uppercase transition-colors text-zinc-500 border-b-2 border-transparent hover:text-zinc-300"
					data-target="tab-experiencia"
				>
					Experiencia
				</button>
			</div>
		</div>

		<!-- Pestaña: Servicios -->
		<div
			id="tab-servicios"
			class="tab-content transition-opacity duration-500 opacity-100"
		>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					servicios.map((item) => (
						<div class="relative group bg-zinc-900/40 border border-white/5 rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/50 hover:shadow-[0_10px_30px_rgba(0,0,0,0.5)] overflow-hidden flex flex-col">
							{item.isPopular && (
								<div class="absolute top-0 right-0 bg-[#D4AF37] text-black text-[10px] md:text-xs font-black px-4 py-1.5 uppercase tracking-widest rounded-bl-xl shadow-lg z-20">
									Más Pedido
								</div>
							)}

							<div class="relative h-48 w-full overflow-hidden">
								<img
									src={item.image}
									alt={item.title}
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-zinc-900/90 to-transparent" />
							</div>

							<div class="p-6 flex-1 flex flex-col relative z-10">
								<div class="flex justify-between items-start mb-3 gap-4">
									<h3 class="text-lg md:text-xl font-medium text-white group-hover:text-[#D4AF37] transition-colors">
										{item.title}
									</h3>
									<span class="text-base md:text-lg font-bold text-[#D4AF37] whitespace-nowrap shrink-0">
										{item.price}
									</span>
								</div>
								<p class="text-zinc-400 text-sm leading-relaxed mt-auto">
									{item.desc}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<!-- Pestaña: Productos -->
		<div
			id="tab-productos"
			class="tab-content hidden transition-opacity duration-500 opacity-0"
		>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
				{
					productos.map((item) => (
						<div class="group cursor-pointer flex flex-col">
							{/* Contenedor de la Imagen del Producto */}
							<div class="relative w-full aspect-square bg-zinc-900 rounded-2xl overflow-hidden mb-6 border border-white/5 group-hover:border-[#D4AF37]/50 transition-colors duration-500 shadow-lg">
								<img
									src={item.image}
									alt={item.title}
									class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
									loading="lazy"
								/>
								{/* Overlay oscuro que aparece en Hover */}
								<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

								{/* Botón Flotante Reveal */}
								<div class="absolute bottom-6 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 w-full px-6">
									<div class="bg-[#D4AF37] text-black text-[11px] font-black uppercase tracking-widest px-4 py-3 rounded-full text-center hover:bg-white transition-colors">
										Ver Detalles
									</div>
								</div>
							</div>

							{/* Textos del Producto (Centrados) */}
							<div class="text-center px-2 flex-1 flex flex-col">
								<h3 class="text-lg font-serif font-bold text-white group-hover:text-[#D4AF37] transition-colors mb-2">
									{item.title}
								</h3>
								<p class="text-zinc-500 text-sm mb-4 line-clamp-2">
									{item.desc}
								</p>

								{/* Precio con barra animada */}
								<div class="mt-auto flex justify-center">
									<div class="relative pb-1">
										<span class="text-[#D4AF37] font-black text-lg tracking-wider">
											{item.price}
										</span>
										<div class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[1px] w-6 bg-white/20 group-hover:w-full group-hover:bg-[#D4AF37] transition-all duration-500" />
									</div>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<!-- Pestaña: Experiencia (Bento Grid) -->
		<div
			id="tab-experiencia"
			class="tab-content hidden transition-opacity duration-500 opacity-0"
		>
			<div
				class="grid grid-cols-1 lg:grid-cols-3 gap-6 auto-rows-[350px]"
			>
				{
					experiencia.map((item) => (
						<div
							class={`relative group rounded-3xl overflow-hidden shadow-xl border border-white/10 ${item.colSpan}`}
						>
							{/* Imagen de Fondo */}
							<img
								src={item.image}
								alt={item.title}
								class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
								loading="lazy"
							/>

							{/* Gradiente de Superposición (dinámico según el tamaño del bloque) */}
							<div
								class={`absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent ${item.colSpan === "lg:col-span-2" || item.colSpan === "lg:col-span-3" ? "md:bg-gradient-to-r md:from-black/90 md:via-black/60" : ""}`}
							/>

							{/* Contenido */}
							<div
								class={`absolute bottom-0 left-0 p-8 md:p-10 w-full ${item.colSpan === "lg:col-span-2" || item.colSpan === "lg:col-span-3" ? "md:w-3/4 lg:w-2/3" : ""}`}
							>
								{/* Ícono animado */}
								<div class="w-14 h-14 rounded-full bg-black/50 backdrop-blur-md text-[#D4AF37] flex items-center justify-center mb-6 border border-[#D4AF37]/30 group-hover:-translate-y-2 transition-transform duration-500 shadow-[0_0_15px_rgba(212,175,55,0.2)]">
									{/* SVG Icon: Coffee */}
									{item.icon === "coffee" && (
										<svg
											class="w-7 h-7"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M15 7.143c1.611.163 3 .891 3 2.857 0 1.966-1.389 2.694-3 2.857M12 18a9 9 0 0 1-9-9V5.25a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 5.25V9a9 9 0 0 1-9 9Z"
											/>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M5.25 18h13.5M9 21h6"
											/>
										</svg>
									)}
									{/* SVG Icon: Lounge/Welcome */}
									{item.icon === "lounge" && (
										<svg
											class="w-7 h-7"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
											/>
										</svg>
									)}
									{/* SVG Icon: Drink */}
									{item.icon === "drink" && (
										<svg
											class="w-7 h-7"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M9.75 21v-3.375M14.25 21v-3.375M7.5 21h9M4.5 4.5h15m-15 0v11.25c0 1.243 1.007 2.25 2.25 2.25h10.5c1.243 0 2.25-1.007 2.25-2.25V4.5m-15 0h15"
											/>
										</svg>
									)}
								</div>

								<h3 class="text-2xl font-serif font-bold text-white mb-3 tracking-wide">
									{item.title}
								</h3>
								<p class="text-zinc-300 text-sm md:text-base leading-relaxed">
									{item.desc}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Ocultar barra de desplazamiento en el contenedor de tabs para móviles */
	.hide-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.hide-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<script>
	// Script para manejar la lógica de pestañas (Tabs)
	const tabBtns = document.querySelectorAll(".tab-btn");
	const tabContents = document.querySelectorAll(".tab-content");

	tabBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			// 1. Resetear el estado de todos los botones
			tabBtns.forEach((b) => {
				b.classList.remove("text-white", "border-[#D4AF37]");
				b.classList.add("text-zinc-500", "border-transparent");
			});

			// 2. Activar el botón clicado
			btn.classList.add("text-white", "border-[#D4AF37]");
			btn.classList.remove("text-zinc-500", "border-transparent");

			// 3. Obtener el ID del contenido a mostrar
			const targetId = btn.getAttribute("data-target");

			// 4. Cambiar la visibilidad de los contenidos con transiciones
			tabContents.forEach((content) => {
				if (content.id === targetId) {
					// Mostrar el contenedor objetivo
					content.classList.remove("hidden");
					// Permitir que el DOM se actualice antes de cambiar la opacidad (Fade-in)
					setTimeout(() => {
						content.classList.remove("opacity-0");
						content.classList.add("opacity-100");
					}, 10);
				} else {
					// Ocultar los contenedores no seleccionados (Fade-out)
					content.classList.remove("opacity-100");
					content.classList.add("opacity-0");

					// Solo aplicar hidden una vez que la transición de opacidad haya terminado
					setTimeout(() => {
						if (content.classList.contains("opacity-0")) {
							content.classList.add("hidden");
						}
					}, 500); // 500ms coincide con duration-500 de Tailwind
				}
			});
		});
	});
</script>
