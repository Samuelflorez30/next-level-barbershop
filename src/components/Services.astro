<style>
	/* Ocultar barra de desplazamiento en el contenedor de tabs para móviles */
	.hide-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.hide-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<script>
	// Script para manejar la lógica de pestañas (Tabs)
	const tabBtns = document.querySelectorAll(".tab-btn");
	const tabContents = document.querySelectorAll(".tab-content");

	tabBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			// 1. Resetear el estado de todos los botones
			tabBtns.forEach((b) => {
				b.classList.remove("text-white", "border-[#D4AF37]");
				b.classList.add("text-zinc-500", "border-transparent");
			});

			// 2. Activar el botón clicado
			btn.classList.add("text-white", "border-[#D4AF37]");
			btn.classList.remove("text-zinc-500", "border-transparent");

			// 3. Obtener el ID del contenido a mostrar
			const targetId = btn.getAttribute("data-target");

			// 4. Cambiar la visibilidad de los contenidos con transiciones
			tabContents.forEach((content) => {
				if (content.id === targetId) {
					// Mostrar el contenedor objetivo
					content.classList.remove("hidden");
					// Permitir que el DOM se actualice antes de cambiar la opacidad (Fade-in)
					setTimeout(() => {
						content.classList.remove("opacity-0");
						content.classList.add("opacity-100");
					}, 10);
				} else {
					// Ocultar los contenedores no seleccionados (Fade-out)
					content.classList.remove("opacity-100");
					content.classList.add("opacity-0");

					// Solo aplicar hidden una vez que la transición de opacidad haya terminado
					setTimeout(() => {
						if (content.classList.contains("opacity-0")) {
							content.classList.add("hidden");
						}
					}, 500); // 500ms coincide con duration-500 de Tailwind
				}
			});
		});
	});
</script>
