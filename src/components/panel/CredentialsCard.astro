---
// Tarjeta con usuario y contraseña temporal de un barbero. Se entrega vacía
// y oculta; el navegador la rellena con `fillCredentials` (credentials.ts)
// tras crear el barbero o generar una contraseña nueva. Solo se muestra una vez.
import { btnPrimary, btnSecondary, eyebrow } from "./ui";
---

<div data-credentials hidden class="border border-[#D4AF37]/40 bg-[#D4AF37]/5 rounded-2xl p-5 sm:p-6">
  <p class={`${eyebrow} mb-4`}>Acceso al panel</p>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-zinc-950 border border-white/10 rounded-xl px-4 py-3">
      <dt class={eyebrow}>Usuario</dt>
      <dd data-cred-username class="font-mono text-lg text-white break-all select-all mt-1"></dd>
    </div>
    <div class="bg-zinc-950 border border-white/10 rounded-xl px-4 py-3">
      <dt class={eyebrow}>Contraseña temporal</dt>
      <dd data-cred-password class="font-mono text-lg text-[#D4AF37] break-all select-all mt-1"></dd>
    </div>
  </dl>
  <div class="flex flex-wrap gap-3 mt-5">
    <button type="button" data-cred-copy class={btnSecondary}>Copiar</button>
    <a data-cred-whatsapp href="#" target="_blank" rel="noopener noreferrer" class={btnPrimary}>
      Enviar acceso por WhatsApp
    </a>
  </div>
  <p role="alert" class="mt-5 flex items-start gap-2 border border-orange-500/40 bg-orange-500/10 text-orange-200 text-sm rounded-md px-4 py-3">
    <span aria-hidden="true">⚠</span>
    <span><strong>Guarda esta contraseña, no se vuelve a mostrar.</strong> El barbero debe cambiarla al entrar, en «Mi cuenta».</span>
  </p>
</div>
