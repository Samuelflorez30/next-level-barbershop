# Base de datos Turso (libSQL). Ver docs/SETUP.md para obtener estos valores.
#   turso db show next-level-barbershop --url      -> TURSO_DATABASE_URL
#   turso db tokens create next-level-barbershop   -> TURSO_AUTH_TOKEN
#
# Para desarrollo local sin Turso puedes usar un archivo SQLite:
#   TURSO_DATABASE_URL=file:local.db
#   (deja TURSO_AUTH_TOKEN vacío)
TURSO_DATABASE_URL=libsql://next-level-barbershop-<tu-org>.turso.io
TURSO_AUTH_TOKEN=

# Opcional: al correr `npm run db:seed`, regenera las contraseñas temporales
# de los usuarios que ya existen (por defecto solo se crean los que faltan).
# SEED_RESET_PASSWORDS=1

# Notificaciones por email (Resend). Si RESEND_API_KEY está vacío, las reservas
# funcionan igual y solo se registra un aviso en la consola del servidor.
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras el dominio no esté verificado usa
# onboarding@resend.dev (solo puede enviar al correo de tu cuenta de Resend).
RESEND_FROM_EMAIL=onboarding@resend.dev
# Correo del dueño que recibe avisos de nuevas reservas y cancelaciones.
NOTIFY_EMAIL=reservasnextlevel@gmail.com
# URL pública del sitio, para los enlaces de los emails (/citas/<token>).
PUBLIC_SITE_URL=https://barbernextlevel.com
